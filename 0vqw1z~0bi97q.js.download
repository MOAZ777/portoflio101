    query PrimaryDomainFieldCheckReplitAppSubdomainAvailability($subdomain: String!, $deploymentId: String, $replId: String, $provider: HostingBuildProvider) {
  replitAppSubdomainAvailability(
    subdomain: $subdomain
    deploymentId: $deploymentId
    replId: $replId
    provider: $provider
  ) {
    __typename
    ... on ReplitAppSubdomainAvailabilityResult {
      available
      message
    }
    ... on UserError {
      errorMessage: message
    }
