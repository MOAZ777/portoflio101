    ${m}`,f=t.gql`
    fragment DeploymentSessionRepl on Repl {
  id
  __typename
  slug
  lastUsedSubdomain
  suggestedUniqueSubdomain
  config {
    isVnc
  }
  source {
    release {
      repl {
        title
      }
    }
  }
