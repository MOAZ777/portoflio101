    ...DeploymentSessionOrg
  }
  owner {
    __typename
    ... on User {
      id
      username
    }
    ... on Team {
      id
      username
    }
  }
  hostingDeployment {
    ... on HostingDeployment {
      ...DeploymentSessionHostingDeployment
    }
    ... on Error {
      message
    }
  }
  hostingDeploymentPermissions {
    hasNeonProductionDatabasesEnabled
  }
  ...DeploymentAuthorizations
}
